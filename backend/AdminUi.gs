function adminHtml_(){return "<!doctype html><html lang=\"id\"><head><base target=\"_top\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><style>\r\nbody{font:13px Arial,sans-serif;margin:0;color:#173348;background:#f5f8fb}header{background:#0061af;color:white;padding:17px}header h1{font-size:19px;margin:0 0 6px}header p{font-size:11px;margin:0;line-height:1.5}main{padding:15px}label{display:block;font-size:11px;font-weight:600;margin:14px 0 6px}input,select,textarea{box-sizing:border-box;width:100%;padding:9px;border:1px solid #d6e0e8;border-radius:5px;background:white;font:12px Arial,sans-serif;color:#173348}textarea{min-height:65px;resize:vertical}input[type=checkbox]{width:auto;margin-right:7px}input[readonly]{background:#eef3f7}button{cursor:pointer;border:0;border-radius:5px;padding:10px;font:600 11px Arial,sans-serif;background:#0061af;color:white}button:disabled{opacity:.5;cursor:wait}.row{display:flex;gap:8px}.row>div{flex:1;min-width:0}.actions{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:18px}.warning{background:#fff4d7;color:#84641b;border-radius:5px;padding:11px;font-size:11px;line-height:1.6}.note{font-size:11px;color:#778b9b;line-height:1.6}.secondary{background:#e7edf3;color:#486174}.danger{background:#965249}.part{border:1px solid #dfe7ee;border-radius:6px;background:white;padding:10px;margin:12px 0}.part h3{margin:0;font-size:12px}#message{font-size:12px;line-height:1.6;margin-top:14px;white-space:pre-wrap}#message.error{color:#a33b25}.checkbox{font-size:11px;font-weight:400;line-height:1.5}.toolbar{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}h2{font-size:14px;margin:20px 0 8px}.hidden{display:none}details{margin:18px 0}summary{font-size:11px;color:#0061af;cursor:pointer}\r\nbody[data-web-admin] main{max-width:850px;margin:auto;padding:24px}body[data-web-admin] header{text-align:center}#login-panel{max-width:430px;margin:32px auto;padding:24px}#login-panel h2{font-size:22px}#login-message{color:#a33b25;line-height:1.6}#logout{margin-left:10px}.drive-picker{padding:12px;background:#eef4fa;margin-top:15px;border-radius:6px}</style></head><body><header><h1>Admin HORI 80</h1><p>Indonesia Berdaulat, APBN Kuat</p></header><section id=\"login-panel\" class=\"hidden\"><h2>Masuk admin</h2><p class=\"note\">Masukkan kunci akses dari pengelola HORI 80.</p><form id=\"login-form\"><label for=\"admin-key\">Kunci akses admin</label><input id=\"admin-key\" type=\"password\" autocomplete=\"off\" required><button id=\"login-button\" type=\"submit\" style=\"margin-top:16px\">Masuk</button></form><p id=\"login-message\" role=\"alert\"></p></section><main id=\"admin-editor\"><div class=\"toolbar\"><span id=\"revision\" class=\"note\">Memuat data…</span><div><button class=\"secondary\" id=\"reload\">Muat ulang</button><button class=\"secondary hidden\" id=\"logout\">Keluar</button></div></div><div class=\"warning\">Gunakan kode peserta. Hindari nama pribadi, NIP, kontak, dan dokumen privat pada isian publik.</div><label for=\"kind\">Kelola</label><select id=\"kind\"><option value=\"matches\">Pertandingan & skor</option><option value=\"schedule\">Jadwal kegiatan</option><option value=\"awards\">Penetapan juara</option><option value=\"penalties\">Penalti MLBB</option><option value=\"groups\">Grup MLBB</option><option value=\"judging\">Penilaian fotografi</option><option value=\"works\">Karya fotografi</option><option value=\"sports\">Cabang & kontribusi medali</option><option value=\"participants\">Peserta anonim</option><option value=\"units\">Unit kerja</option><option value=\"settings\">Pengaturan pengesahan</option></select><label for=\"sport-filter\">Filter cabor</label><select id=\"sport-filter\"><option value=\"\">Semua cabor</option></select><div id=\"selector\"></div><form id=\"form\"><div id=\"fields\"></div><label for=\"reason\">Alasan koreksi / pembatalan</label><textarea id=\"reason\" placeholder=\"Wajib untuk koreksi atau pembatalan\"></textarea><div class=\"actions\"><button type=\"button\" data-action=\"save\">Simpan draft</button><button type=\"button\" data-action=\"approve\">Sahkan hasil</button><button class=\"secondary\" type=\"button\" data-action=\"correct\">Koreksi</button><button class=\"danger\" type=\"button\" data-action=\"revoke\">Batalkan pengesahan</button></div></form><div id=\"message\" role=\"status\"></div><details><summary>Catatan referensi untuk admin</summary><div id=\"source-notes\" class=\"note\"></div></details></main><script>\r\n(function(root){\r\n'use strict';\r\nfunction unit(data,id){return data.units.find(u=>u.id===id);}\r\nfunction sport(data,id){return data.sports.find(s=>s.id===id);}\r\nfunction validOfficial(m){return m&&m.state==='official'&&!m.needsReview;}\r\nfunction resolvedMatch(data,m,visited){\r\n const copy=JSON.parse(JSON.stringify(m)),seen=new Set(visited||[]);if(seen.has(m.id))throw Error('Siklus bagan tidak valid.');seen.add(m.id);\r\n ['A','B'].forEach(side=>{const src=m['source'+side];if(!src)return;const parent=data.matches.find(x=>x.id===src.match);if(!validOfficial(parent)){copy['team'+side]=null;return;}const p=resolvedMatch(data,parent,seen);copy['team'+side]=src.outcome==='winner'?p.winnerId:(p.teamA===p.winnerId?p.teamB:p.teamA);});return copy;\r\n}\r\nfunction medals(data,sportId){\r\n const rows=data.units.map(u=>({...u,gold:0,silver:0,bronze:0,total:0})),seen=new Set();\r\n data.awards.filter(a=>a.state==='official'&&(!sportId||a.sportId===sportId)).forEach(a=>{const s=sport(data,a.sportId),key=a.sportId+'|'+a.categoryId+'|'+a.rank;if(!s||!s.medalEnabled||!s.medalConfirmed||seen.has(key)||a.exhibition)return;seen.add(key);const u=rows.find(r=>r.id===a.unitId);if(!u)return;const field={1:'gold',2:'silver',3:'bronze'}[a.rank];if(field){u[field]++;u.total++;}});\r\n rows.sort((a,b)=>b.gold-a.gold||b.silver-a.silver||b.bronze-a.bronze||a.name.localeCompare(b.name,'id'));\r\n let prev=null;rows.forEach((r,i)=>{r.rank=data.settings.standingsConfirmed&&r.total?((prev&&r.gold===prev.gold&&r.silver===prev.silver&&r.bronze===prev.bronze)?prev.rank:i+1):null;prev=r;});return rows;\r\n}\r\nfunction photoScore(values,scale){if(!Number.isFinite(scale)||scale<=0||!Array.isArray(values)||values.length!==5)throw Error('Tetapkan skala dan lima nilai penjurian.');if(values.some(v=>!Number.isFinite(v)||v<0||v>scale))throw Error('Nilai di luar skala.');return Math.round(values.reduce((a,v,i)=>a+v/scale*[30,25,20,15,10][i],0)*100)/100;}\r\nfunction validateGame(g,s,settings){\r\n if(!Number.isInteger(g.a)||!Number.isInteger(g.b)||g.a<0||g.b<0||g.a===g.b)throw Error('Skor gim harus bilangan bulat dan menentukan pemenang.');\r\n const hi=Math.max(g.a,g.b),lo=Math.min(g.a,g.b),target=s.id==='tenis-meja'?11:21;\r\n if(hi<target)throw Error('Gim belum mencapai target poin.');\r\n if(s.id==='bulutangkis'){if(hi>30||!(hi===target&&lo<=target-2||hi>target&&hi<30&&hi-lo===2||hi===30&&(lo===28||lo===29)))throw Error('Skor gim bulutangkis tidak valid.');if(lo>=20&&!settings.badmintonDeuce)throw Error('Konfirmasi aturan deuce bulutangkis dahulu.');}\r\n else {if(!(hi===11&&lo<=9||hi>11&&hi-lo===2))throw Error('Skor gim tenis meja tidak valid.');if(lo>=10&&!settings.tennisTableDeuce)throw Error('Konfirmasi deuce tenis meja dahulu.');}\r\n return g.a>g.b?'A':'B';\r\n}\r\nfunction validateMatch(data,input){\r\n const m=resolvedMatch(data,input),s=sport(data,m.sportId);if(!s)throw Error('Cabang tidak ditemukan.');if(!m.teamA||!m.teamB||m.teamA===m.teamB)throw Error('Dua peserta resmi harus tersedia.');if(![m.teamA,m.teamB].includes(m.winnerId))throw Error('Pemenang harus merupakan salah satu peserta.');\r\n if(m.wo){if(m.parts&&m.parts.length||m.scoreA!=null||m.scoreB!=null)throw Error('WO disimpan tanpa skor fiktif.');return {...m,status:'Selesai'};}\r\n if(s.type==='team'){\r\n  if(s.id==='tenis-meja'&&!data.settings.tableOrderConfirmed)throw Error('Sahkan urutan partai tenis meja dahulu.');\r\n  const order=s.id==='bulutangkis'?['Ganda campuran','Ganda putra','Ganda putri']:data.settings.tablePartOrder;\r\n  if(!Array.isArray(m.parts)||m.parts.length!==3)throw Error('Isi tiga partai, termasuk Tidak dimainkan bila perlu.');\r\n  let a=0,b=0;const need=Math.ceil(s.bestOf/2);\r\n  m.parts.forEach((p,i)=>{\r\n   if(p.name!==order[i])throw Error('Urutan partai tidak sesuai konfigurasi.');\r\n   if(a===2||b===2){if(p.status!=='Tidak dimainkan'||p.games&&p.games.length)throw Error('Partai setelah kemenangan tim harus Tidak dimainkan tanpa skor.');return;}\r\n   if(p.status!=='Selesai'||!Array.isArray(p.games))throw Error('Partai wajib memiliki skor gim selesai.');\r\n   let ga=0,gb=0;p.games.forEach(g=>{if(ga===need||gb===need)throw Error('Ada gim setelah partai berakhir.');const win=validateGame(g,s,data.settings);if(win==='A')ga++;else gb++;});\r\n   if(Math.max(ga,gb)!==need)throw Error('Partai belum selesai.');p.scoreA=ga;p.scoreB=gb;if(ga>gb)a++;else b++;\r\n  });\r\n  if(Math.max(a,b)!==2)throw Error('Tim belum memenangkan dua partai.');m.scoreA=a;m.scoreB=b;\r\n } else if(s.id==='mlbb'){\r\n  const need=m.stage==='Grand final'?3:2;\r\n  if(!Number.isInteger(m.scoreA)||!Number.isInteger(m.scoreB)||m.scoreA<0||m.scoreB<0||Math.max(m.scoreA,m.scoreB)!==need||Math.min(m.scoreA,m.scoreB)>=need)throw Error('Skor seri tidak sesuai BO3/BO5.');\r\n } else if(s.id==='tenis-lapangan'){\r\n  const target=m.stage==='Final'?7:6,hi=Math.max(m.scoreA,m.scoreB),lo=Math.min(m.scoreA,m.scoreB);\r\n  if(!Number.isInteger(m.scoreA)||!Number.isInteger(m.scoreB)||lo<0||hi!==target||lo>target-1)throw Error('Skor set tidak sesuai pro set lokal.');\r\n  if(lo===target-1){const tb=m.tieBreak;if(!tb||!Number.isInteger(tb.a)||!Number.isInteger(tb.b))throw Error('Isi skor tie-break.');const h=Math.max(tb.a,tb.b),l=Math.min(tb.a,tb.b);if(!(h===7&&l<=5||h>7&&h<10&&h-l===2||h===10&&(l===8||l===9)))throw Error('Tie-break lokal tidak valid.');if((tb.a>tb.b)!==(m.scoreA>m.scoreB))throw Error('Pemenang tie-break tidak sesuai skor set.');}\r\n } else {if(!Number.isFinite(m.scoreA)||!Number.isFinite(m.scoreB)||m.scoreA===m.scoreB||m.scoreA<0||m.scoreB<0)throw Error('Isi skor akhir yang menentukan pemenang.');}\r\n if((m.scoreA>m.scoreB?m.teamA:m.teamB)!==m.winnerId)throw Error('Pemenang tidak sesuai skor.');return {...m,status:'Selesai'};\r\n}\r\nfunction groupTable(data,group){\r\n const rows=group.unitIds.map(id=>({unitId:id,played:0,won:0,lost:0,gameWins:0,gameLosses:0,penalty:0,points:0,percent:0}));\r\n const matches=data.matches.filter(m=>m.sportId==='mlbb'&&m.groupId===group.id&&validOfficial(m));\r\n matches.forEach(m=>{const a=rows.find(x=>x.unitId===m.teamA),b=rows.find(x=>x.unitId===m.teamB);if(!a||!b)return;[a,b].forEach(r=>r.played++);const win=m.winnerId===m.teamA?a:b,lose=win===a?b:a;win.won++;lose.lost++;\r\n if(!m.wo){a.gameWins+=m.scoreA;a.gameLosses+=m.scoreB;b.gameWins+=m.scoreB;b.gameLosses+=m.scoreA;}\r\n if(data.settings.mlPointsUnit==='match')win.points++;\r\n if(data.settings.mlPointsUnit==='game'){if(m.wo)win.points++;else{a.points+=m.scoreA;b.points+=m.scoreB;}}\r\n });\r\n data.penalties.filter(p=>p.state==='official'&&p.groupId===group.id).forEach(p=>{const r=rows.find(x=>x.unitId===p.unitId);if(r)r.penalty+=p.points;});\r\n rows.forEach(r=>{r.points+=r.penalty;r.percent=r.gameWins+r.gameLosses?r.gameWins/(r.gameWins+r.gameLosses)*100:0;});\r\n rows.sort((a,b)=>b.points-a.points||b.percent-a.percent);\r\n const buckets=new Map();rows.forEach(r=>{const key=r.points+'|'+r.percent;if(!buckets.has(key))buckets.set(key,[]);buckets.get(key).push(r);});\r\n buckets.forEach(tied=>{if(tied.length===2){const head=matches.filter(m=>tied.every(r=>[m.teamA,m.teamB].includes(r.unitId)));const counts=tied.map(r=>head.filter(m=>m.winnerId===r.unitId).length);if(counts[0]!==counts[1]){const p=rows.indexOf(tied[0]);if(counts[1]>counts[0])rows.splice(p,2,tied[1],tied[0]);return;}}if(tied.length>1)tied.forEach(r=>r.tieUnresolved=true);});\r\n return {official:!!data.settings.mlConfirmed&&['match','game'].includes(data.settings.mlPointsUnit),rows};\r\n}\r\nconst api={unit,sport,validOfficial,resolvedMatch,medals,photoScore,validateMatch,groupTable};root.HORI_ENGINE=api;if(typeof module==='object'&&module.exports)module.exports=api;\r\n})(typeof window==='undefined'?globalThis:window);\r\n\r\nlet data=null,current=null,busy=false,pending=null,adminToken=null,driveFiles=[];\r\nconst webMode=document.body.dataset.webAdmin==='true';\r\nconst E=globalThis.HORI_ENGINE,$=id=>document.getElementById(id),esc=v=>String(v??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\r\nfunction option(items,value,blank=true){return (blank?'<option value=\"\">Pilih</option>':'')+items.map(x=>'<option value=\"'+esc(x.id)+'\" '+(x.id===value?'selected':'')+'>'+esc(x.name||x.short||x.label||x.id)+'</option>').join('');}\r\nfunction input(k,label,value='',type='text'){return '<label for=\"f-'+k+'\">'+esc(label)+'</label><input id=\"f-'+k+'\" name=\"'+k+'\" type=\"'+type+'\" value=\"'+esc(value??'')+'\">';}\r\nfunction select(k,label,items,value){return '<label for=\"f-'+k+'\">'+esc(label)+'</label><select id=\"f-'+k+'\" name=\"'+k+'\">'+option(items,value)+'</select>';}\r\nfunction area(k,label,value=''){return '<label for=\"f-'+k+'\">'+esc(label)+'</label><textarea id=\"f-'+k+'\" name=\"'+k+'\">'+esc(value)+'</textarea>';}\r\nfunction check(k,label,value){return '<label class=\"checkbox\"><input type=\"checkbox\" id=\"f-'+k+'\" name=\"'+k+'\" '+(value?'checked':'')+'>'+esc(label)+'</label>';}\r\nfunction lock(value){busy=value;document.querySelectorAll('button').forEach(b=>b.disabled=value);$('kind').disabled=value;}\r\nfunction message(text,error=false){$('message').textContent=text;$('message').classList.toggle('error',error);}\r\nfunction load(preferredId){if(typeof preferredId!=='string')preferredId=current?.id||null;lock(true);google.script.run.withSuccessHandler(d=>{data=d;pending=null;lock(false);const selected=$('sport-filter').value||document.body.dataset.initialSport||'';$('sport-filter').innerHTML='<option value=\"\">Semua cabor</option>'+option(d.sports,selected,false);$('sport-filter').value=selected;document.body.dataset.initialSport='';$('revision').textContent='Revisi '+d.settings.revision;renderSelector(preferredId);$('source-notes').innerHTML=d.sports.flatMap(s=>(s.notes||[]).map(n=>'<p><b>'+esc(s.name)+'</b>: '+esc(n)+'</p>')).join('');}).withFailureHandler(e=>{lock(false);message(e.message,true);if(webMode&&/Sesi admin/.test(e.message)){showLogin();$('login-message').textContent=e.message;}}).adminLoad(adminToken);}\r\nfunction recordLabel(kind,x){if(kind==='matches')return (data.sports.find(s=>s.id===x.sportId)?.name||'')+' · '+x.label+' · '+x.stage;return x.title||x.name||x.short||x.code||x.id;}\r\nfunction renderSelector(preferredId){const k=$('kind').value;if(k==='settings'){$('selector').innerHTML='';current=null;renderFields();return;}const chosen=$('sport-filter').value;const list=(data[k]||[]).filter(x=>!chosen||!['matches','schedule','awards','sports','participants','works','judging'].includes(k)||(k==='sports'?x.id===chosen:k==='works'||k==='judging'?chosen==='fotografi':x.sportId===chosen));$('selector').innerHTML='<label for=\"record\">Pilih data</label><select id=\"record\">'+(k==='sports'?'':'<option value=\"\">+ Tambah data</option>')+list.map(x=>'<option value=\"'+esc(x.id)+'\">'+esc(recordLabel(k,x))+'</option>').join('')+'</select>';if(preferredId&&list.some(x=>x.id===preferredId))$('record').value=preferredId;else if(k==='matches'&&list.length)$('record').value=list[0].id;current=list.find(x=>x.id===$('record').value)||null;$('record').onchange=()=>{current=list.find(x=>x.id===$('record').value)||null;renderFields();};renderFields();}\r\nfunction localTime(s){return s?new Date(s).toLocaleString('sv-SE',{timeZone:'Asia/Jakarta'}).replace(' ','T').slice(0,16):'';}\r\nfunction renderFields(){const kind=$('kind').value,c=current||{},units=data.units.map(u